# 이 파일을 .env 로 복사하고 값을 채우세요.

# 설명 화면 기획(Claude). 없으면 설명 화면 단계를 건너뜁니다.
ANTHROPIC_API_KEY=

# 일러스트 생성(OpenAI gpt-image-1). 없으면 플레이스홀더 도형 카드로 대체됩니다.
OPENAI_API_KEY=

# ── 선택 설정 (기본값 표시) ─────────────────────────────
# WHISPER_MODEL=large-v3          # 느리면 medium / small
# WHISPER_DEVICE=auto             # auto | cuda | cpu
# LANGUAGE=ko

# SILENCE_DB=-35                  # 무음 판정 기준(dB)
# MIN_SILENCE=0.6                 # 이 길이(초) 이상 무음만 편집
# KEEP_SILENCE=0.3                # 긴 무음을 이 길이로 줄임
# REMOVE_STUTTERS=true

# ILLUSTRATIONS=true
# ILLUSTRATION_MODE=overlay       # overlay(투명 스티커) | center(중앙 카드) | pip(우측 카드) | cutaway(전체 전환)
# SCENE_POSITION=center           # 일러스트 위치: center | left | right | top-right | bottom-right ...
# SCENE_HEIGHT=0.62               # 일러스트 크기 (화면 높이 비율)
# OVERLAY_HEIGHT=0.32             # 아이콘·로고 크기 (화면 높이 비율)
# SFX=true                        # 등장/퇴장 효과음
# SFX_VOLUME=0.35
# OVERLAYS=true                   # 투명 로고·아이콘 오버레이
# MAX_SCENES_PER_MIN=1.5
# MAX_OVERLAYS_PER_MIN=4
# WEB_PORT=8766
# CLAUDE_MODEL=claude-opus-5
# IMAGE_PROVIDER=auto             # auto | openai | placeholder
# IMAGE_MODEL=gpt-image-1
# IMAGE_QUALITY=medium            # low | medium | high
# LOGO_DIR=./로고

# MOSAIC=true
# OCR_INTERVAL=0.5                # 초 단위 화면 검사 간격 (짧을수록 정확, 느림)
# BLUR_FACES=false                # 얼굴 모자이크 (본인 얼굴도 가려지므로 기본 OFF)
# MUTE_SPOKEN_PII=false           # 말로 나온 개인정보 음소거

# VIDEO_CODEC=auto                # auto | h264_nvenc | libx264
# VIDEO_QUALITY=19                # 낮을수록 고화질(파일 커짐)
# OUT_DIR=./output
# WORK_DIR=./work

# ── Google Drive 업로드 (선택, 클라우드 세션용) ────────────────
# GDRIVE_SERVICE_ACCOUNT_JSON=   # 서비스 계정 키 JSON 본문 또는 파일 경로. 폴더를 client_email에 편집자로 공유
# GDRIVE_FOLDER_ID=              # 결과를 올릴 Drive 폴더 ID (또는 --drive-folder)
